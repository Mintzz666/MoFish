# MoFish 环境变量示例（复制为 .env 或在 shell 里导出后构建）
#
# 这些变量只在**构建期**（npm run build）读取，用来生成 dist/config.js。
# 它们不会被提交：.env 已在 .gitignore 中；dist/ 同样被忽略。
#
# ---------------------------------------------------------------------------
# 可以进入前端的公开值（必须填写）
# ---------------------------------------------------------------------------
# Supabase 项目地址，形如 https://<project-ref>.supabase.co
# 在 Supabase 控制台 → Project Settings → Data API / API 里可以找到。
MOFISH_SUPABASE_URL=

# 公开 key：anon JWT（role=anon）或新版 sb_publishable_ 开头的 key。
# 它会被写进网页，这是设计如此——真正的数据边界是数据库的 RLS 策略。
MOFISH_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# 绝对不能进入前端的机密（本文件里留空，绝不写进仓库或聊天）
# ---------------------------------------------------------------------------
# service_role key：可绕过 RLS，等同于数据库管理员权限。
# 仅用于服务端脚本（例如本地导出备份），绝不放进 MOFISH_SUPABASE_ANON_KEY，
# 也绝不放进 dist/、config.js 或任何会被浏览器加载的文件。
# 构建脚本检测到它出现在 ANON_KEY 位置时会直接让构建失败。
MOFISH_SERVICE_ROLE_KEY=            # 仅本机使用，例如备份脚本；不要提交、不要粘贴到聊天里

# SMTP / 发信凭据属于 Supabase 控制台配置（Authentication → Emails），
# 不经过本仓库，也不要写进任何 .env 提交上去。
# 示例（仅示意字段名，不要填写真实值）：
# MOFISH_SMTP_HOST=
# MOFISH_SMTP_USER=
# MOFISH_SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# 部署（Cloudflare Workers 静态资源）
# ---------------------------------------------------------------------------
# 本地部署用 wrangler 登录，令牌只放在本机或 CI 的 secret 存储中：
CLOUDFLARE_API_TOKEN=               # 仅部署时使用；不要提交
CLOUDFLARE_ACCOUNT_ID=              # 可选；账号下有多个账号时需要
